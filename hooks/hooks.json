{
  "description": "Inside Herdr, redirect Agent calls that can write or run long to herdr-spawn.sh",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/route-agent-to-herdr.sh\"",
            "timeout": 15,
            "statusMessage": "Routing delegated work to Herdr"
          }
        ]
      }
    ]
  }
}
